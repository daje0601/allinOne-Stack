# 백엔드가 호출할 로컬 vLLM 엔드포인트들. 기본값으로도 동작합니다.
STT_BASE=http://localhost:11000/v1
STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=ko

LLM_BASE=http://localhost:13000/v1
LLM_MODEL=iamjoon/llama3-8b-persona-chatbot
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7
LLM_SYSTEM_PROMPT=너는 친근한 한국어 음성 챗봇이야. 답변은 한 두 문장으로 짧고 자연스럽게 해줘.

TTS_BASE=http://localhost:12000/v1
TTS_VOICE=sohee
TTS_LANGUAGE=Korean

# 서버 자신
APP_HOST=0.0.0.0
APP_PORT=14000
